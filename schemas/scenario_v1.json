{
  "$defs": {
    "AgentSpec": {
      "additionalProperties": false,
      "properties": {
        "age": {
          "exclusiveMinimum": 0,
          "title": "Age",
          "type": "integer"
        },
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "background": {
          "minLength": 1,
          "title": "Background",
          "type": "string"
        },
        "goals": {
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "location_path": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Path"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "personality": {
          "$ref": "#/$defs/PersonalitySpec"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "agent_id",
        "name",
        "age",
        "background",
        "personality"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "EnvironmentSpec": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Conditions",
          "type": "object"
        },
        "location_path": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Location Path",
          "type": "array"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        }
      },
      "required": [
        "start_time",
        "location_path"
      ],
      "title": "EnvironmentSpec",
      "type": "object"
    },
    "EthicsSpec": {
      "additionalProperties": false,
      "properties": {
        "fictional": {
          "default": true,
          "title": "Fictional",
          "type": "boolean"
        },
        "irb_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irb Notes"
        },
        "no_prediction": {
          "default": true,
          "title": "No Prediction",
          "type": "boolean"
        },
        "no_real_people": {
          "default": true,
          "title": "No Real People",
          "type": "boolean"
        },
        "no_suspect_scoring": {
          "default": true,
          "title": "No Suspect Scoring",
          "type": "boolean"
        },
        "sensitive_domain": {
          "default": false,
          "title": "Sensitive Domain",
          "type": "boolean"
        }
      },
      "title": "EthicsSpec",
      "type": "object"
    },
    "EventSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "event_type",
        "participants",
        "location",
        "description"
      ],
      "title": "EventSpec",
      "type": "object"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "score",
            "latency"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "description"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "PersonalitySpec": {
      "additionalProperties": false,
      "properties": {
        "agreeableness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Agreeableness",
          "type": "number"
        },
        "conscientiousness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Conscientiousness",
          "type": "number"
        },
        "extraversion": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Extraversion",
          "type": "number"
        },
        "neuroticism": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Neuroticism",
          "type": "number"
        },
        "openness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Openness",
          "type": "number"
        }
      },
      "required": [
        "openness",
        "conscientiousness",
        "extraversion",
        "agreeableness",
        "neuroticism"
      ],
      "title": "PersonalitySpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scenario DSL v1 root object.",
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentSpec"
      },
      "minItems": 1,
      "title": "Agents",
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "domain": {
      "enum": [
        "game",
        "public_safety_research",
        "academic_research"
      ],
      "title": "Domain",
      "type": "string"
    },
    "duration_days": {
      "default": 1,
      "minimum": 1,
      "title": "Duration Days",
      "type": "integer"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentSpec"
    },
    "ethics": {
      "$ref": "#/$defs/EthicsSpec"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventSpec"
      },
      "title": "Events",
      "type": "array"
    },
    "local_response": {
      "default": "{\"action_type\": \"observe\", \"target\": null, \"content\": \"records the scenario state.\"}",
      "title": "Local Response",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricSpec"
      },
      "title": "Metrics",
      "type": "array"
    },
    "scenario_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "tick_duration_minutes": {
      "default": 60,
      "minimum": 1,
      "title": "Tick Duration Minutes",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "title",
    "domain",
    "description",
    "seed",
    "environment",
    "agents"
  ],
  "title": "Scenario",
  "type": "object"
}
