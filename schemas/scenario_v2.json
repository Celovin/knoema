{
  "$defs": {
    "AgentSpec": {
      "additionalProperties": false,
      "properties": {
        "age": {
          "exclusiveMinimum": 0,
          "title": "Age",
          "type": "integer"
        },
        "agent_id": {
          "minLength": 1,
          "title": "Agent Id",
          "type": "string"
        },
        "background": {
          "minLength": 1,
          "title": "Background",
          "type": "string"
        },
        "goals": {
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        },
        "location_path": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Path"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "personality": {
          "$ref": "#/$defs/PersonalitySpec"
        },
        "routine": {
          "items": {
            "$ref": "#/$defs/RoutineSpec"
          },
          "title": "Routine",
          "type": "array"
        },
        "synthetic": {
          "default": true,
          "title": "Synthetic",
          "type": "boolean"
        },
        "values": {
          "items": {
            "type": "string"
          },
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "agent_id",
        "name",
        "age",
        "background",
        "personality"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "EnvironmentSpecV2": {
      "additionalProperties": false,
      "description": "Environment with optional GIS-readiness fields.\n\n``h3_cell`` and ``epsg`` are optional in v2. When ``ethics.no_real_geometry``\nis true (the default), ``epsg`` must either be unset or use the\n``luvoire-synthetic-*`` prefix; runtime use as an analysis unit is rejected\nby :mod:`luvoire.dsl.v2.validator`.",
      "properties": {
        "conditions": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Conditions",
          "type": "object"
        },
        "epsg": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Epsg"
        },
        "h3_cell": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H3 Cell"
        },
        "location_path": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Location Path",
          "type": "array"
        },
        "start_time": {
          "format": "date-time",
          "title": "Start Time",
          "type": "string"
        }
      },
      "required": [
        "start_time",
        "location_path"
      ],
      "title": "EnvironmentSpecV2",
      "type": "object"
    },
    "EthicsSpecV2": {
      "additionalProperties": false,
      "description": "Ethics declarations extended with the ``no_real_geometry`` guardrail.",
      "properties": {
        "fictional": {
          "default": true,
          "title": "Fictional",
          "type": "boolean"
        },
        "irb_notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Irb Notes"
        },
        "no_prediction": {
          "default": true,
          "title": "No Prediction",
          "type": "boolean"
        },
        "no_real_geometry": {
          "default": true,
          "title": "No Real Geometry",
          "type": "boolean"
        },
        "no_real_people": {
          "default": true,
          "title": "No Real People",
          "type": "boolean"
        },
        "no_suspect_scoring": {
          "default": true,
          "title": "No Suspect Scoring",
          "type": "boolean"
        },
        "sensitive_domain": {
          "default": false,
          "title": "Sensitive Domain",
          "type": "boolean"
        }
      },
      "title": "EthicsSpecV2",
      "type": "object"
    },
    "EventSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "event_type": {
          "minLength": 1,
          "title": "Event Type",
          "type": "string"
        },
        "location": {
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "participants": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Participants",
          "type": "array"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "event_type",
        "participants",
        "location",
        "description"
      ],
      "title": "EventSpec",
      "type": "object"
    },
    "MetricSpec": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "kind": {
          "enum": [
            "count",
            "ratio",
            "score",
            "latency"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "description"
      ],
      "title": "MetricSpec",
      "type": "object"
    },
    "PersonalitySpec": {
