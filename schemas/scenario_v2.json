    },
    "RoutineSpec": {
      "additionalProperties": false,
      "properties": {
        "default_action": {
          "minLength": 1,
          "title": "Default Action",
          "type": "string"
        },
        "default_target": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default Target"
        },
        "end_hour": {
          "maximum": 24,
          "minimum": 0,
          "title": "End Hour",
          "type": "integer"
        },
        "location_path": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Location Path",
          "type": "array"
        },
        "start_hour": {
          "maximum": 24,
          "minimum": 0,
          "title": "Start Hour",
          "type": "integer"
        }
      },
      "required": [
        "start_hour",
        "end_hour",
        "location_path",
        "default_action"
      ],
      "title": "RoutineSpec",
      "type": "object"
    },
    "TierAParam": {
      "additionalProperties": false,
      "description": "Locked theoretical constant. Only ``ref`` may be set.",
      "properties": {
        "ref": {
          "pattern": "^code:[a-z_][a-z0-9_.]*\\.v\\d+$",
          "title": "Ref",
          "type": "string"
        },
        "tier": {
          "const": "A",
          "default": "A",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "TierAParam",
      "type": "object"
    },
    "TierBParam": {
      "additionalProperties": false,
      "description": "Empirical prior with required source metadata.",
      "properties": {
        "default": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Default"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "distribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "range": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Range"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "table_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table Id"
        },
        "tier": {
          "const": "B",
          "default": "B",
          "title": "Tier",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "source"
      ],
      "title": "TierBParam",
      "type": "object"
    },
    "TierCParam": {
      "additionalProperties": false,
      "description": "Exploration knob with required range and default.",
      "properties": {
        "default": {
          "title": "Default",
          "type": "number"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range",
          "type": "array"
        },
        "sweep": {
          "anyOf": [
            {
              "minimum": 2,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep"
        },
        "tier": {
          "const": "C",
          "default": "C",
          "title": "Tier",
          "type": "string"
        }
      },
      "required": [
        "range",
        "default"
      ],
      "title": "TierCParam",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Scenario DSL v2 root object.",
  "properties": {
    "agents": {
      "items": {
        "$ref": "#/$defs/AgentSpec"
      },
      "minItems": 1,
      "title": "Agents",
      "type": "array"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "domain": {
      "enum": [
        "game",
        "public_safety_research",
        "academic_research"
      ],
      "title": "Domain",
      "type": "string"
    },
    "duration_days": {
      "default": 1,
      "minimum": 1,
      "title": "Duration Days",
      "type": "integer"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentSpecV2"
    },
    "ethics": {
      "$ref": "#/$defs/EthicsSpecV2"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/EventSpec"
      },
      "title": "Events",
      "type": "array"
    },
    "local_response": {
      "default": "{\"action_type\": \"observe\", \"target\": null, \"content\": \"records the scenario state.\"}",
      "title": "Local Response",
      "type": "string"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricSpec"
      },
      "title": "Metrics",
      "type": "array"
    },
    "parameters": {
      "additionalProperties": {
        "discriminator": {
          "mapping": {
            "A": "#/$defs/TierAParam",
            "B": "#/$defs/TierBParam",
            "C": "#/$defs/TierCParam"
          },
          "propertyName": "tier"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TierAParam"
          },
          {
            "$ref": "#/$defs/TierBParam"
          },
          {
            "$ref": "#/$defs/TierCParam"
          }
        ]
      },
      "title": "Parameters",
      "type": "object"
    },
    "scenario_id": {
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Scenario Id",
      "type": "string"
    },
    "schema_version": {
      "const": "2.0",
      "default": "2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    },
    "tick_duration_minutes": {
      "default": 60,
      "minimum": 1,
      "title": "Tick Duration Minutes",
      "type": "integer"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "scenario_id",
    "title",
    "domain",
    "description",
    "seed",
    "environment",
    "agents"
  ],
  "title": "ScenarioV2",
  "type": "object"
}
